<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>S&O Fashion Hub | Uyo — Where Uniqueness & Quality Speaks</title>
  <meta name="description" content="S&O Fashion Hub — premium bespoke fashion, footwear and custom styling in Uyo, Akwa Ibom. Clothing, footwear, tailoring and full customization.">
  <link rel="icon" href="data:image/jpeg;base64," type="image/jpeg">

  <style>
    :root {
      --bg: #0b0b0b;
      --bg-soft: #121212;
      --card: #171717;
      --gold: #d4af37;
      --gold-light: #f2d675;
      --cream: #f5f0e6;
      --muted: #aaa39a;
      --white: #ffffff;
      --line: rgba(212,175,55,.22);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Georgia, "Times New Roman", serif;
      background:
        radial-gradient(circle at 80% 10%, rgba(212,175,55,.08), transparent 30%),
        var(--bg);
      color: var(--cream);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    ::selection {
      background: var(--gold);
      color: #111;
    }

    /* SCROLL REVEAL */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .8s ease, transform .8s ease;
    }
    .reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    /* NAVIGATION */
    nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(11,11,11,.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }

    .nav-inner {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    /* EMBLEM (real logo) */
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .emblem {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--gold);
      display: grid;
      place-items: center;
      overflow: hidden;
      padding: 4px;
      box-shadow: 0 0 0 3px rgba(212,175,55,.12);
    }

    .emblem img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 50%;
    }

    .brand-text {
      line-height: 1.1;
    }

    .brand-text strong {
      display: block;
      font-size: 15px;
      color: var(--white);
    }

    .brand-text span {
      font-family: Arial, sans-serif;
      font-size: 9px;
      color: var(--gold);
      letter-spacing: 3px;
    }

    .nav-links {
      display: flex;
      gap: 26px;
      font-family: Arial, sans-serif;
      font-size: 13px;
    }

    .nav-links a {
      color: #ddd;
      transition: .3s;
      position: relative;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0;
      height: 1px;
      background: var(--gold);
      transition: .3s;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .menu-btn {
      display: none;
      background: none;
      border: 1px solid var(--line);
      color: var(--gold);
      padding: 9px 12px;
      border-radius: 6px;
      font-size: 20px;
    }

    /* ANNOUNCEMENT BAR */
    .announce {
      background: linear-gradient(90deg, #000, #1a1a1a, #000);
      border-bottom: 1px solid var(--line);
      overflow: hidden;
      white-space: nowrap;
    }

    .announce-track {
      display: inline-flex;
      gap: 60px;
      padding: 9px 0;
      animation: scrollLeft 22s linear infinite;
      font-family: Arial, sans-serif;
      font-size: 11.5px;
      letter-spacing: 2px;
      color: var(--gold-light);
      text-transform: uppercase;
    }

    @keyframes scrollLeft {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* HERO */
    .hero {
      min-height: 88vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.82)),
        radial-gradient(circle at center, rgba(212,175,55,.12), transparent 42%);
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      border: 1px solid rgba(212,175,55,.12);
      border-radius: 50%;
      right: -220px;
      top: 80px;
    }

    .hero-content {
      max-width: 750px;
      position: relative;
      z-index: 2;
    }

    .eyebrow {
      font-family: Arial, sans-serif;
      color: var(--gold-light);
      letter-spacing: 5px;
      font-size: 11px;
      text-transform: uppercase;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .eyebrow::before {
      content: "";
      width: 30px;
      height: 1px;
      background: var(--gold);
      display: inline-block;
    }

    h1 {
      font-size: clamp(48px, 9vw, 92px);
      line-height: .95;
      font-weight: 500;
      letter-spacing: -3px;
    }

    h1 span {
      background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-style: italic;
    }

    .hero p {
      max-width: 600px;
      margin: 28px 0;
      color: #c7c1b8;
      font-family: Arial, sans-serif;
      font-size: 15px;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      margin: 30px 0 34px;
      font-family: Arial, sans-serif;
    }

    .hero-badge {
      font-size: 12px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .hero-badge b {
      color: var(--gold-light);
      font-size: 20px;
      font-family: Georgia, serif;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 22px;
      border-radius: 2px;
      font-family: Arial, sans-serif;
      font-size: 13px;
      font-weight: bold;
      transition: .3s;
      cursor: pointer;
    }

    .btn-gold {
      background: var(--gold);
      color: #111;
      box-shadow: 0 0 0 0 rgba(212,175,55,.5);
    }

    .btn-gold:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px -6px rgba(212,175,55,.55);
    }

    .btn-outline {
      border: 1px solid var(--gold);
      color: var(--gold-light);
    }

    .btn-outline:hover {
      background: rgba(212,175,55,.1);
    }

    /* SECTIONS */
    section {
      padding: 90px 0;
    }

    .section-label {
      font-family: Arial, sans-serif;
      color: var(--gold);
      font-size: 11px;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-label::before {
      content: "";
      width: 22px;
      height: 1px;
      background: var(--gold);
    }

    .section-title {
      font-size: clamp(32px, 6vw, 54px);
      font-weight: 500;
      margin-bottom: 18px;
    }

    .section-intro {
      max-width: 650px;
      color: var(--muted);
      font-family: Arial, sans-serif;
    }

    .gold-italic {
      color: var(--gold);
      font-style: italic;
    }

    /* ABOUT */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-box {
      border: 1px solid var(--line);
      background: linear-gradient(145deg, #161616, #0d0d0d);
      padding: 45px;
      min-height: 330px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
    }

    .big-emblem {
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--gold);
      display: grid;
      place-items: center;
      padding: 14px;
      box-shadow: 0 0 60px -10px rgba(212,175,55,.35);
    }

    .big-emblem img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 50%;
    }

    .about-text p {
      color: #bcb6ad;
      font-family: Arial, sans-serif;
      margin-bottom: 18px;
    }

    .about-list {
      list-style: none;
      display: grid;
      gap: 12px;
      margin: 24px 0 28px;
      font-family: Arial, sans-serif;
      font-size: 14px;
      color: #ddd;
    }

    .about-list li {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .about-list li::before {
      content: "✦";
      color: var(--gold);
      font-size: 12px;
    }

    /* STATS STRIP */
    .stats {
      background: #0f0f0f;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 46px 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      text-align: center;
    }

    .stat-num {
      font-size: clamp(26px, 4vw, 40px);
      color: var(--gold-light);
      font-weight: 500;
    }

    .stat-label {
      font-family: Arial, sans-serif;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 6px;
    }

    /* SERVICES */
    .services {
      background: #0f0f0f;
      border-top: 1px solid rgba(212,175,55,.08);
      border-bottom: 1px solid rgba(212,175,55,.08);
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 40px;
    }

    .service-card {
      padding: 32px 26px;
      background: #151515;
      border: 1px solid rgba(255,255,255,.06);
      transition: .3s;
    }

    .service-card:hover {
      border-color: var(--line);
      transform: translateY(-5px);
      box-shadow: 0 20px 40px -20px rgba(212,175,55,.25);
    }

    .service-number {
      color: var(--gold);
      font-family: Arial, sans-serif;
      font-size: 12px;
      margin-bottom: 20px;
    }

    .service-card h3 {
      font-size: 22px;
      margin-bottom: 12px;
      font-weight: 500;
    }

    .service-card p {
      color: #999;
      font-family: Arial, sans-serif;
      font-size: 13px;
    }

    .custom-banner {
      margin-top: 40px;
      border: 1px solid var(--line);
      background: linear-gradient(120deg, rgba(212,175,55,.12), transparent 60%), #141414;
      padding: 34px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .custom-banner h4 {
      font-size: 22px;
      margin-bottom: 6px;
    }

    .custom-banner p {
      font-family: Arial, sans-serif;
      color: var(--muted);
      font-size: 13px;
    }

    /* GALLERY / COLLECTION */
    .collection-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-top: 40px;
    }

    .fashion-card {
      min-height: 340px;
      border: 1px solid rgba(212,175,55,.15);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
    }

    .fashion-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .6s ease;
    }

    .fashion-card:hover img {
      transform: scale(1.08);
    }

    .fashion-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,.05) 30%, rgba(0,0,0,.9) 100%);
      z-index: 1;
    }

    .fashion-card .tag {
      position: relative;
      z-index: 2;
      padding: 22px;
      width: 100%;
    }

    .fashion-card .tag span {
      display: block;
      font-family: Arial, sans-serif;
      font-size: 10px;
      letter-spacing: 3px;
      color: var(--gold-light);
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .fashion-card h3 {
      font-size: 22px;
    }

    .collection-cta {
      text-align: center;
      margin-top: 34px;
    }

    /* WHY CHOOSE US */
    .why {
      background: #0f0f0f;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-top: 40px;
    }

    .why-card {
      text-align: center;
      padding: 28px 18px;
    }

    .why-icon {
      width: 58px;
      height: 58px;
      margin: 0 auto 16px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--gold-light);
      font-size: 22px;
    }

    .why-card h4 {
      font-size: 16px;
      margin-bottom: 8px;
    }

    .why-card p {
      font-family: Arial, sans-serif;
      font-size: 12.5px;
      color: var(--muted);
    }

    /* SHOWROOM */
    .showroom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .showroom-photo {
      border: 1px solid var(--line);
      overflow: hidden;
      position: relative;
    }

    .showroom-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      min-height: 380px;
    }

    .showroom-text p {
      color: #bcb6ad;
      font-family: Arial, sans-serif;
      margin-bottom: 18px;
    }

    /* BOOKING */
    .booking {
      background: #111;
    }

    .booking-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 45px;
      align-items: start;
    }

    .booking-info p {
      color: #aaa;
      font-family: Arial, sans-serif;
      margin-bottom: 25px;
    }

    .contact-list {
      display: grid;
      gap: 12px;
      font-family: Arial, sans-serif;
      font-size: 14px;
    }

    .contact-item {
      border-left: 2px solid var(--gold);
      padding: 10px 15px;
      background: rgba(255,255,255,.025);
    }

    .social-row {
      display: flex;
      gap: 12px;
      margin-top: 26px;
    }

    .social-row a {
      width: 42px;
      height: 42px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--gold-light);
      font-family: Arial, sans-serif;
      font-size: 12px;
      font-weight: bold;
      transition: .3s;
    }

    .social-row a:hover {
      background: var(--gold);
      color: #111;
      transform: translateY(-3px);
    }

    form {
      background: #181818;
      border: 1px solid var(--line);
      padding: 30px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    label {
      font-family: Arial, sans-serif;
      font-size: 11px;
      color: #b9b0a3;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid rgba(255,255,255,.1);
      background: #0e0e0e;
      color: white;
      padding: 13px;
      outline: none;
      font-family: Arial, sans-serif;
      border-radius: 2px;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--gold);
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .submit {
      width: 100%;
      margin-top: 18px;
      border: none;
    }

    .form-note {
      font-family: Arial, sans-serif;
      font-size: 11px;
      color: var(--muted);
      margin-top: 12px;
      text-align: center;
    }

    /* CONTACT */
    .contact-section {
      text-align: center;
    }

    .contact-section .section-intro,
    .contact-section .section-label {
      margin: 0 auto;
    }

    .contact-section .section-label {
      justify-content: center;
    }

    .contact-section .section-label::before {
      display: none;
    }

    .contact-section .section-intro {
      margin-bottom: 30px;
    }

    .map-frame {
      margin-top: 34px;
      border: 1px solid var(--line);
      overflow: hidden;
    }

    .map-frame iframe {
      width: 100%;
      height: 340px;
      border: 0;
      filter: grayscale(1) invert(92%) contrast(90%);
    }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--line);
      padding: 45px 0 25px;
      background: #090909;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 30px;
      padding-bottom: 30px;
      border-bottom: 1px solid rgba(212,175,55,.12);
      margin-bottom: 22px;
    }

    .footer-tag {
      max-width: 320px;
      font-family: Arial, sans-serif;
      font-size: 12.5px;
      color: #8a8378;
      margin-top: 14px;
    }

    .footer-links {
      display: flex;
      gap: 60px;
      flex-wrap: wrap;
    }

    .footer-col h5 {
      font-family: Arial, sans-serif;
      font-size: 12px;
      letter-spacing: 2px;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .footer-col a {
      display: block;
      font-family: Arial, sans-serif;
      font-size: 13px;
      color: #ccc;
      margin-bottom: 10px;
      transition: .3s;
    }

    .footer-col a:hover {
      color: var(--gold-light);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
    }

    footer p {
      font-family: Arial, sans-serif;
      color: #777;
      font-size: 12px;
    }

    .footer-social {
      display: flex;
      gap: 10px;
    }

    .social {
      width: 40px;
      height: 40px;
      border: 1px solid rgba(212,175,55,.3);
      display: grid;
      place-items: center;
      color: var(--gold);
      font-family: Arial, sans-serif;
      font-size: 11px;
      border-radius: 50%;
      transition: .3s;
    }

    .social:hover {
      background: var(--gold);
      color: #111;
    }

    /* FLOATING WHATSAPP */
    .float-wa {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 999;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: var(--gold);
      display: grid;
      place-items: center;
      box-shadow: 0 10px 30px -6px rgba(212,175,55,.6);
      animation: pulse 2.4s infinite;
      font-size: 26px;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(212,175,55,.55); }
      70% { box-shadow: 0 0 0 16px rgba(212,175,55,0); }
      100% { box-shadow: 0 0 0 0 rgba(212,175,55,0); }
    }

    /* MOBILE */
    @media (max-width: 800px) {
      .nav-links {
        display: none;
        position: absolute;
        top: 78px;
        left: 0;
        right: 0;
        background: #0c0c0c;
        border-bottom: 1px solid var(--line);
        padding: 20px;
        flex-direction: column;
      }

      .nav-links.active {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .about-grid,
      .booking-grid,
      .showroom-grid {
        grid-template-columns: 1fr;
      }

      .showroom-grid {
        gap: 30px;
      }

      .service-grid,
      .collection-grid {
        grid-template-columns: 1fr;
      }

      .why-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }

      .hero {
        min-height: 80vh;
      }

      .about-box {
        min-height: 270px;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }

      .footer-top {
        flex-direction: column;
      }

      .float-wa {
        width: 52px;
        height: 52px;
        bottom: 16px;
        right: 16px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <nav>
    <div class="container nav-inner">

      <a href="#home" class="brand">
        <div class="emblem"><img src="data:image/jpeg;base64,
